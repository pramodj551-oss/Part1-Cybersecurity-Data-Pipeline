{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Cybersecurity Incident Analytics — EDA\n",
        "Production-ready exploratory analysis using the centrally configured cleaned dataset."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pathlib import Path\n",
        "import sys\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "PROJECT_ROOT = Path.cwd()\n",
        "if not (PROJECT_ROOT / 'src').exists():\n",
        "    PROJECT_ROOT = PROJECT_ROOT.parent\n",
        "sys.path.insert(0, str(PROJECT_ROOT))\n",
        "\n",
        "from src.config import CLEAN_DATA_FILE, EXPECTED_COLUMNS, NUMERIC_COLUMNS, CATEGORICAL_COLUMNS, BOOLEAN_COLUMNS\n",
        "\n",
        "if not CLEAN_DATA_FILE.exists():\n",
        "    raise FileNotFoundError(f'Clean dataset not found: {CLEAN_DATA_FILE}. Run run_pipeline.py first.')\n",
        "\n",
        "df = pd.read_csv(CLEAN_DATA_FILE)\n",
        "if 'incident_date' not in df.columns:\n",
        "    raise ValueError(\"Required column 'incident_date' is missing.\")\n",
        "df['incident_date'] = pd.to_datetime(df['incident_date'], errors='coerce')\n",
        "missing_columns = [c for c in EXPECTED_COLUMNS if c not in df.columns]\n",
        "if missing_columns:\n",
        "    raise ValueError(f'Missing required columns: {missing_columns}')\n",
        "if df.empty:\n",
        "    raise ValueError('EDA dataset is empty.')\n",
        "if df['incident_id'].isna().any() or df['incident_id'].duplicated().any():\n",
        "    raise ValueError('EDA input contains missing or duplicate incident IDs.')\n",
        "if df['incident_date'].isna().any():\n",
        "    raise ValueError('EDA input contains invalid/missing incident dates.')\n",
        "print(f'Rows: {len(df):,}')\n",
        "print(f'Columns: {len(df.columns)}')"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Data quality"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "quality = pd.DataFrame({\n",
        "dtype": df.dtypes.astype(str),\n",
        "missing": df.isna().sum(),\n",
        "missing_pct": (df.isna().mean() * 100).round(2),\n",
        "unique": df.nunique(dropna=False)\n",
        "})\n",
        "quality.sort_values('missing', ascending=False)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Numeric and categorical analysis"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "available_numeric = [c for c in NUMERIC_COLUMNS if c in df.columns]\n",
        "print('Numeric summary')\n",
        "display(df[available_numeric].describe().T.round(2))\n",
        "\n",
        "for column in [c for c in CATEGORICAL_COLUMNS if c in df.columns]:\n",
        "    print(f'\\n{column}')\n",
        "    display(df[column].value_counts(dropna=False).head(10).to_frame('count'))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Incident trends and severity"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "monthly = df.set_index('incident_date').resample('ME').size().rename('incident_count')\n",
        "ax = monthly.plot(kind='line', figsize=(10, 4), marker='o')\n",
        "ax.set_title('Monthly Cybersecurity Incident Volume')\n",
        "ax.set_xlabel('Month')\n",
        "ax.set_ylabel('Incidents')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "ax = df['severity_score'].plot(kind='hist', bins=10, figsize=(8, 4))\n",
        "ax.set_title('Severity Score Distribution')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": ["## Financial and security indicators"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "financial_columns = [c for c in ['ransom_demand_usd', 'regulatory_fine_usd'] if c in df.columns]\n",
        "display(df[financial_columns].sum().to_frame('total_usd'))\n",
        "boolean_rates = {c: round(float(df[c].mean() * 100), 2) for c in BOOLEAN_COLUMNS if c in df.columns}\n",
        "display(pd.Series(boolean_rates, name='true_rate_percent').to_frame())\n",
        "display(df[available_numeric].corr(numeric_only=True).round(2))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Conclusion\n",
        "Use this notebook for descriptive analysis only. Train/test-dependent transformations must be fitted on the training split in the future ML stage to avoid leakage."
      ]
    }
  ],
