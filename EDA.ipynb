{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Cybersecurity Incident Analytics — EDA\n",
    "\n",
    "Production-ready exploratory analysis using the project's centrally configured processed dataset.\n",
    "\n",
    "The notebook intentionally avoids hard-coded `/content/...` paths so it works after cloning the repository."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import sys\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "PROJECT_ROOT = Path.cwd()\n",
    "if not (PROJECT_ROOT / 'src').exists():\n",
    "    PROJECT_ROOT = Path.cwd().parent\n",
    "sys.path.insert(0, str(PROJECT_ROOT))\n",
    "\n",
    "from src.config import CLEAN_DATA_FILE, EXPECTED_COLUMNS, NUMERIC_COLUMNS, CATEGORICAL_COLUMNS, BOOLEAN_COLUMNS\n",
    "\n",
    "print(f'Project root: {PROJECT_ROOT}')\n",
    "print(f'Clean dataset: {CLEAN_DATA_FILE}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "if not CLEAN_DATA_FILE.exists():\n",
    "    raise FileNotFoundError(\n",
    "        f'Clean dataset not found: {CLEAN_DATA_FILE}. Run `python run_pipeline.py` first.'\n",
    "    )\n",
    "\n",
    "df = pd.read_csv(CLEAN_DATA_FILE, parse_dates=['incident_date'])\n",
    "\n",
    "missing_columns = [c for c in EXPECTED_COLUMNS if c not in df.columns]\n",
    "if missing_columns:\n",
    "    raise ValueError(f'Missing required columns: {missing_columns}')\n",
    "if df.empty:\n",
    "    raise ValueError('EDA dataset is empty.')\n",
    "\n",
    "print(f'Rows: {len(df):,}')\n",
    "print(f'Columns: {len(df.columns)}')\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Data-quality overview"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "quality = pd.DataFrame({\n",
    "dtype": df.dtypes.astype(str),\n",
    "missing": df.isna().sum(),\n",
    "missing_pct": (df.isna().mean() * 100).round(2),\n",
    "unique": df.nunique(dropna=False),\n",
    "}).sort_values('missing', ascending=False)\n",
    "quality"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "duplicate_ids = int(df['incident_id'].duplicated().sum())\n",
    "invalid_dates = int(df['incident_date'].isna().sum())\n",
    "print(f'Duplicate incident IDs: {duplicate_ids}')\n",
    "print(f'Invalid/missing incident dates: {invalid_dates}')\n",
    "assert duplicate_ids == 0, 'EDA input contains duplicate incident IDs.'\n",
    "assert invalid_dates == 0, 'EDA input contains invalid/missing incident dates.'"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Numeric summary"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "available_numeric = [c for c in NUMERIC_COLUMNS if c in df.columns]\n",
    "numeric_summary = df[available_numeric].describe().T\n",
    "numeric_summary['median'] = df[available_numeric].median()\n",
    "numeric_summary.round(2)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Categorical distributions"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "for column in [c for c in CATEGORICAL_COLUMNS if c in df.columns]:\n",
    "    print(f'\\n{column}')\n",
    "    display(df[column].value_counts(dropna=False).head(10).to_frame('count'))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Incident trends"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "monthly = (\n",
    "    df.set_index('incident_date')\n",
    "      .resample('ME')\n",
    "      .size()\n",
    "      .rename('incident_count')\n",
    ")\n",
    "\n",
    "ax = monthly.plot(kind='line', figsize=(10, 4), marker='o')\n",
    "ax.set_title('Monthly Cybersecurity Incident Volume')\n",
    "ax.set_xlabel('Month')\n",
    "ax.set_ylabel('Incidents')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Severity and financial impact"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "df['severity_score'].plot(kind='hist', bins=10, ax=ax)\n",
    "ax.set_title('Severity Score Distribution')\n",
    "ax.set_xlabel('Severity Score')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "financial = df[['ransom_demand_usd', 'regulatory_fine_usd']].sum().sort_values(ascending=False)\n",
    "print('Total financial impact components:')\n",
    "display(financial.to_frame('usd'))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Resolution and security indicators"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "boolean_rates = {\n",
    "    column: round(float(df[column].mean() * 100), 2)\n",
    "    for column in BOOLEAN_COLUMNS\n",
    "    if column in df.columns\n",
    "}\n",
    "pd.Series(boolean_rates, name='true_rate_percent').to_frame()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Correlation overview"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "corr = df[available_numeric].corr(numeric_only=True)\n",
    "corr.round(2)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### EDA conclusion\n",
    "\n",
    "Use this notebook for descriptive analysis only. Train/test-dependent transformations should be fitted on the training split in the future ML stage to avoid leakage."
   ]
  }
 ],
